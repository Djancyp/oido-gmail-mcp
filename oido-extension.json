{
  "name": "oido-gmail",
  "version": "1.0.0",
  "description": "Send, receive, and search emails via IMAP/SMTP using MCP server. Authenticate with your own Google OAuth connection.",
  "runtime": "make build",
  "mcpServers": {
    "oido-gmail": {
      "command": "${extensionPath}/oido-gmail-mcp",
      "args": [],
      "env": {
        "GOOGLE_CLIENT_ID": "${GOOGLE_CLIENT_ID}",
        "GOOGLE_CLIENT_SECRET": "${GOOGLE_CLIENT_SECRET}",
        "GOOGLE_ACCESS_TOKEN": "${GOOGLE_ACCESS_TOKEN}",
        "GOOGLE_OAUTH_EMAIL": "${GOOGLE_OAUTH_EMAIL}",
        "GMAIL_ALLOW_SEND": "${GMAIL_ALLOW_SEND}",
        "GMAIL_ALLOW_RECEIVE": "${GMAIL_ALLOW_RECEIVE}"
      }
    }
  },
  "contextFileName": "OIDO.md",
  "excludeTools": [],
  "settings": [
    {
      "name": "GOOGLE_CLIENT_ID",
      "description": "Google OAuth client ID (from your Google Cloud project)",
      "defaultValue": "",
      "type": "string",
      "sensitive": true
    },
    {
      "name": "GOOGLE_CLIENT_SECRET",
      "description": "Google OAuth client secret",
      "defaultValue": "",
      "type": "string",
      "sensitive": true
    },
    {
      "name": "GOOGLE_OAUTH",
      "description": "Connect your Google account for Gmail IMAP/SMTP access",
      "type": "oauth2",
      "provider": "google",
      "scopes": [
        "https://mail.google.com/",
        "https://www.googleapis.com/auth/userinfo.email"
      ],
      "clientIdKey": "GOOGLE_CLIENT_ID",
      "clientSecretKey": "GOOGLE_CLIENT_SECRET",
      "tokenKey": "GOOGLE_ACCESS_TOKEN"
    },
    {
      "name": "GMAIL_ALLOW_SEND",
      "description": "Allow sending emails via SMTP",
      "defaultValue": "false",
      "type": "bool"
    },
    {
      "name": "GMAIL_ALLOW_RECEIVE",
      "description": "Allow reading/receiving emails via IMAP",
      "defaultValue": "true",
      "type": "bool"
    }
  ]
}
