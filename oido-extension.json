{
  "name": "oido-gmail",
  "version": "1.0.0",
  "description": "Send, receive, and search emails via IMAP/SMTP using MCP server. Auth with a Gmail App Password or your own Google OAuth connection.",
  "runtime": "make build",
  "mcpServers": {
    "oido-gmail": {
      "command": "${extensionPath}/oido-gmail-mcp",
      "args": [],
      "env": {
        "GMAIL_EMAIL": "${GMAIL_EMAIL}",
        "GMAIL_PASSWORD": "${GMAIL_PASSWORD}",
        "GOOGLE_CLIENT_ID": "${GOOGLE_CLIENT_ID}",
        "GOOGLE_CLIENT_SECRET": "${GOOGLE_CLIENT_SECRET}",
        "GOOGLE_ACCESS_TOKEN": "${GOOGLE_ACCESS_TOKEN}",
        "GOOGLE_OAUTH_EMAIL": "${GOOGLE_OAUTH_EMAIL}",
        "GMAIL_IMAP_HOST": "${GMAIL_IMAP_HOST}",
        "GMAIL_IMAP_PORT": "${GMAIL_IMAP_PORT}",
        "GMAIL_SMTP_HOST": "${GMAIL_SMTP_HOST}",
        "GMAIL_SMTP_PORT": "${GMAIL_SMTP_PORT}",
        "GMAIL_ALLOW_SEND": "${GMAIL_ALLOW_SEND}",
        "GMAIL_ALLOW_RECEIVE": "${GMAIL_ALLOW_RECEIVE}"
      }
    }
  },
  "contextFileName": "OIDO.md",
  "excludeTools": [],
  "settings": [
    {
      "name": "GMAIL_EMAIL",
      "description": "Email address for IMAP/SMTP authentication",
      "defaultValue": "",
      "type": "string"
    },
    {
      "name": "GMAIL_PASSWORD",
      "description": "App password (optional if you connect via Google OAuth below). Use a Gmail App Password, not your account password.",
      "defaultValue": "",
      "type": "string",
      "sensitive": true
    },
    {
      "name": "GOOGLE_CLIENT_ID",
      "description": "Google OAuth client ID (only if authenticating with OAuth instead of an app password)",
      "defaultValue": "",
      "type": "string",
      "sensitive": true
    },
    {
      "name": "GOOGLE_CLIENT_SECRET",
      "description": "Google OAuth client secret",
      "defaultValue": "",
      "type": "string",
      "sensitive": true
    },
    {
      "name": "GOOGLE_OAUTH",
      "description": "Connect your Google account for IMAP/SMTP access (alternative to an app password)",
      "type": "oauth2",
      "provider": "google",
      "scopes": [
        "https://mail.google.com/",
        "https://www.googleapis.com/auth/userinfo.email"
      ],
      "clientIdKey": "GOOGLE_CLIENT_ID",
      "clientSecretKey": "GOOGLE_CLIENT_SECRET",
      "tokenKey": "GOOGLE_ACCESS_TOKEN"
    },
    {
      "name": "GMAIL_IMAP_HOST",
      "description": "IMAP server host",
      "defaultValue": "imap.gmail.com",
      "type": "string"
    },
    {
      "name": "GMAIL_IMAP_PORT",
      "description": "IMAP server port",
      "defaultValue": "993",
      "type": "string"
    },
    {
      "name": "GMAIL_SMTP_HOST",
      "description": "SMTP server host",
      "defaultValue": "smtp.gmail.com",
      "type": "string"
    },
    {
      "name": "GMAIL_SMTP_PORT",
      "description": "SMTP server port",
      "defaultValue": "587",
      "type": "string"
    },
    {
      "name": "GMAIL_ALLOW_SEND",
      "description": "Allow sending emails via SMTP",
      "defaultValue": "false",
      "type": "bool"
    },
    {
      "name": "GMAIL_ALLOW_RECEIVE",
      "description": "Allow reading/receiving emails via IMAP",
      "defaultValue": "true",
      "type": "bool"
    }
  ]
}
